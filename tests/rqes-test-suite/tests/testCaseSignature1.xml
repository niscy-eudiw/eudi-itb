    <actors>
        <gitb:actor id="simulatedDocumentRetrieval" name="Simulated Document Retrieval" />
        <gitb:actor id="relyingParty" name="Relying Party" />
        <gitb:actor id="wallet" name="Wallet" role="SUT"/>
    </actors>

    <steps>
        <verify handler="ExpressionValidator" desc="Verify Relying Party URL is set" stopOnError="true">
            <input name="expression">$DOMAIN{relyingPartyURL} != ""</input>
            <input name="successMessage">"URL of Relying Party requesting document signing is defined."</input>
            <input name="failureMessage">"URL of Relying Party requesting document signing is not defined."</input>
        </verify>

        <assign to="documentSignatureSetupURL">$DOMAIN{relyingPartyURL} || "/tests/get"</assign>
        <assign to="signedDocumentURL">$DOMAIN{relyingPartyURL} || "/tests/get"</assign>
        <assign to="relyingPartyLogsURL">$DOMAIN{relyingPartyURL} || "/tests/logs"</assign>
        <log>"Document Signature Request Object retrieved from: " || $documentSignatureSetupURL</log>
        
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>
        <send  id="documentSignatureRequest" desc="Send request to setup document signing request" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty" stopOnError="true">
            <input name="uri">$documentSignatureSetupURL</input>
            <input name="method">"GET"</input>
            <input name="headers">$httpHeaders</input>
        </send>
        <verify handler="ExpressionValidator" desc="Verify http status code of document signature setup" stopOnError="true">
            <input name="expression">$documentSignatureRequest{response}{status} = "200"</input>
            <input name="successMessage">"The received http status code was 200."</input>
            <input name="failureMessage">"The received http status code was not 200."</input>
        </verify>
        <assign to="documentSignatureResponse" source="$documentSignatureRequest{response}{body}" type="string"/>
        <process handler="JsonPathProcessor" operation="process" output="transactionId" stopOnError="true">
           <input name="content">$documentSignatureResponse</input>
           <input name="expression">"$.transaction_id"</input>
           <input name="outputType">"default"</input>
        </process>
        <log> "document signature setup response transaction id:" || $transactionId</log>
        <process handler="JsonPathProcessor" operation="process" output="base64Img" stopOnError="true" >
           <input name="content">$documentSignatureResponse</input>
           <input name="expression">"$.qr_code"</input>
           <input name="outputType">"default"</input>
        </process>
        <log>"document signature setup response qr_code:" || $base64Img</log>

        <interact inputTitle="Scan the QR Code" desc="Scan the QR Code with your wallet." with="wallet" stopOnError="true" >
            <instruct desc="Click on the magnifying glass to display the QR code"/>
            <instruct desc="Scan this QR with your wallet" contentType="BASE64" mimeType="image/png">$base64Img</instruct>
            <instruct desc="After signing the document with your wallet, click on the Close button to continue"/>
        </interact>

        <log>"Retrieving signed document at: " || $signedDocumentURL || "/" || $transactionId</log>
        <assign to="attempt" type="number">1</assign>
        <assign to="maxAttempts" type="number">$DOMAIN{maxAttempts}</assign>
        <assign to="signedDocStatus">'404'</assign>
        <assign to="signedDocResponse">'none'</assign>
        <while title="HTTP Call Loop to the Relying Party" desc="Make HTTP calls until successful signed document is received or timeout" stopOnError="true" >
            <cond><![CDATA[$attempt <= $maxAttempts and $signedDocStatus = '404']]></cond>
            <do>
                <log>"Making HTTP request (attempt " || $attempt || ")..."</log>
                <send id="signedDocResponse" desc="Retrieve signed document" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty">
                    <input name="uri">$signedDocumentURL || "/" || $transactionId</input>
                    <input name="method">"GET"</input>
                    <input name="headers">$httpHeaders</input>
                </send>
                <assign to="signedDocStatus" type="string">$signedDocResponse{response}{status}</assign>
                <assign to="attempt" type="number">$attempt + 1</assign>
                <process handler="DelayProcessor" operation="delay" input="$DOMAIN{delayBetweenCalls}"/>
            </do>
        </while>         
        <verify handler="ExpressionValidator" desc="Verify http status code of the signed document retrieval request"  stopOnError="true" >
            <input name="expression">$signedDocStatus = "200"</input>
            <input name="successMessage">"The received http status code was 200."</input>
            <input name="failureMessage">"The received http status code was not 200."</input>
        </verify>
        <log>"Logs Retrieval body:" || $signedDocResponse{response}{body}</log>

        <send id="signatureLogs" desc="Retrieve signature logs" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty">
            <input name="uri">$relyingPartyLogsURL || "/"  || $transactionId</input>
            <input name="method">"GET"</input>
        </send>
        <verify handler="ExpressionValidator" desc="Verify http status code of the signature logs retrieval" stopOnError="true">
            <input name="expression">$signatureLogs{response}{status} = "200"</input>
            <input name="successMessage">"The received http status code was 200."</input>
            <input name="failureMessage">"The received http status code was not 200."</input>
        </verify>
        <log>$signatureLogs{response}{body}</log>

        <verify handler="$DOMAIN{qesValidationService}" desc="Validate signature logs" >
            <input name="text">$signatureLogs{response}{body}</input>
        </verify>

    </steps>
    <output>
        <success>
            <default>"Test session succeeded."</default>
        </success>
        <failure>
            <default>"Test session failed. Refer to the failed step's report for more details."</default>
        </failure>
    </output>
</testcase>